# ---- Email option A: your own mailbox via SMTP (e.g. Hostinger email) ----
SMTP_HOST=                 # Hostinger: smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=                 # the mailbox, e.g. quotes@yourdomain.com
SMTP_PASS=                 # that mailbox's password

# ---- Email option B: Resend - https://resend.com (used only if SMTP_* is empty) ----
RESEND_API_KEY=
LEADS_TO_EMAIL=            # where requests are delivered
LEADS_CC_EMAIL=            # optional, comma-separated extra recipients (cc)
LEADS_FROM_EMAIL=          # e.g. "Writing Lab <quotes@yourdomain.com>" (must match the SMTP mailbox)

# ---- Google Drive storage (optional) ----
GOOGLE_DRIVE_FOLDER_ID=
# Personal Gmail Drive: OAuth (recommended)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# OR Google Workspace shared drive: service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---- Public site settings ----
NEXT_PUBLIC_SITE_URL=https://writinglab.site
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_WHATSAPP=       # digits only with country code
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_ADDRESS=
