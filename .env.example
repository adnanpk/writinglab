# Email (Resend) - https://resend.com
RESEND_API_KEY=
LEADS_TO_EMAIL=            # where you receive leads
LEADS_FROM_EMAIL=          # e.g. "Writing Lab <quotes@yourdomain.com>" (verified domain), or onboarding@resend.dev for testing

# Google Drive (service account) - share your Drive folder with the service-account email
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=        # keep \n escapes, wrap in quotes
GOOGLE_DRIVE_FOLDER_ID=

# Public site settings (fill when ready)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_WHATSAPP=       # digits only with country code, e.g. 966500000000
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_ADDRESS=
